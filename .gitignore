web/dist/
web/dist-ssr/
web/.output/
web/.nitro/
web/.tanstack/
web/.vinxi/
web/.wrangler/
__unconfig*
*.local

# ---- Env & secrets ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
!**/testdata/**/*.pem
!**/testdata/**/*.key

