# ---- Go ----
# Compiled binaries / build output
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Local build artifacts from `go build` in cmd dirs
/api/api
/api/cmd/api/api
/daemon/daemon
/daemon/cmd/daemon/daemon

# Test & coverage output
*.test
*.out
coverage.*
cover.out
profile.out

# Go workspace (machine-specific)
go.work
go.work.sum

# Delve / debug binaries
__debug_bin*

# ---- Node / web ----
node_modules/
.pnp
.pnp.js
.npm
.eslintcache
*.tsbuildinfo

